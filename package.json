    "check": "node scripts/check.mjs",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy"
  },
  "dependencies": { "entities": "^9.0.0" },
  "devDependencies": { "wrangler": "^4.166.0" }
}
